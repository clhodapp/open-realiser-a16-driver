#!/usr/bin/env python3
"""Play a static Custom #2 RF64 upmix directly to the A16, bypassing live upmixing."""
import argparse,json,os,subprocess
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('file',type=Path)
a=p.parse_args()
if not a.file.is_file():p.error('Audio file does not exist')
objects=json.loads(subprocess.check_output([os.environ.get('PW_DUMP','pw-dump'),'--remote','pipewire-0']))
sink=next((o.get('info',{}).get('props',{}) for o in objects if o.get('info',{}).get('props',{}).get('node.name')=='ozzy.a16.playback'),None)
if sink is None:p.error('The Realiser USB bridge is not running')
if sink.get('a16.profile')!='custom-2' or int(sink.get('audio.channels',0))!=16:
 p.error('Select the 16-channel Custom #2 card profile and align the Realiser PCM room before playing this file')
cat=os.environ.get('PW_CAT','pw-cat')
os.execvp(cat,[cat,'--remote','pipewire-0','--playback','--target','ozzy.a16.playback','--latency','500ms','--properties','{ node.name = a16.static.player stream.dont-remix = true channelmix.upmix = false channelmix.mix-lfe = false }','--channel-map','FL,FR,FC,LFE,FLC,FRC,SL,SR,RL,RR,RC,TFL,TFR,TRL,TRR,TC',str(a.file.resolve())])
