/* SPDX-License-Identifier: MIT */
/*
 * Ozzy Device List
 *
 * The device's protocol family, channel counts and rates used by the engine.
 * See ozzy_devices.h for table lookup and .claude/re/device_inventory.md for sources.
 *
 *   OZZY_DEVICE(key, vid, pid, name, family, in, out, rates, status)
 *
 *   key        device identifier
 *   family     PLOYTEC_XONE  Ploytec junction protocol, bulk/interrupt out
 *   in, out    audio channels (lanes used in the device's frames)
 *   rates      OZZY_RATE_xxx bits
 *   status     SUPPORTED or EXPERIMENTAL (untested on hardware or by few users)
 *
 * Copyright (C) 2024 Marcel Bierling <marcel@hackerman.art>
 */

/*
 * Smyth Research Realiser A16 3.4.13 kext (Ploytec, no kConfigurationData): 2 in / 16 out from the
 * fallback table (dmaEncode16). 44.1/48 kHz validated by the userspace harness. No device-specific
 * requests that change Ozzy's handshake (the official configurationDone skips its first selector
 * call, the second still runs).
 */
OZZY_DEVICE(SmythRealiserA16, 0x0A4A, 0x5A16, "Smyth Research Realiser A16", PLOYTEC_XONE, 2, 16,
	    OZZY_RATE_44K1 | OZZY_RATE_48K | OZZY_RATE_88K2 | OZZY_RATE_96K, EXPERIMENTAL)
